com"},{id:"prf_03",userId:"usr_03",name:"Camila Duarte",belt:"preta",yearsTeaching:9,specialties:["Guarda","Competição","No-Gi"],city:"Curitiba",state:"PR",country:"Brasil",bio:"Treinadora de equipe competitiva gi e no-gi. Organiza ciclos de campeonato, filmagem de treino e preparação física específica para adultas e adultos.",lookingForWork:!0,contactEmail:"camila@jobsbjj.com"},{id:"prf_04",userId:"usr_04",name:"Thiago Nunes",belt:"preta",yearsTeaching:15,specialties:["Luta em pé","Defesa pessoal","Fundamentação"],city:"Recife",state:"PE",country:"Brasil",bio:"Professor titular com passagem por programas de defesa pessoal para empresas e turmas regulares. Foco em postura, clinch e base para iniciantes adultos.",lookingForWork:!1,contactEmail:"thiago@jobsbjj.com"},{id:"prf_05",userId:"usr_05",name:"Beatriz Lopes",belt:"roxa",yearsTeaching:4,specialties:["Infantil","Fundamentação","Condicionamento"],city:"Belo Horizonte",state:"MG",country:"Brasil",bio:"Professora de kids e recreação. Formada em educação física, une brincadeira, disciplina e coordenação motora para turmas de 5 a 12 anos.",lookingForWork:!0,contactEmail:"beatriz@jobsbjj.com"},{id:"prf_06",userId:"usr_06",name:"Lucas Ferreira",belt:"preta",yearsTeaching:8,specialties:["No-Gi","Luta em pé","Competição"],city:"Florianópolis",state:"SC",country:"Brasil",bio:"Coach de no-gi e wrestling aplicado ao jiu-jitsu. Atua com atletas amadores e com turmas de meio período no fim do dia.",lookingForWork:!0,contactEmail:"lucas@jobsbjj.com"},{id:"prf_07",userId:"usr_07",name:"Ana Paula Ribeiro",belt:"marrom",yearsTeaching:7,specialties:["Feminino","Defesa pessoal","Fundamentação"],city:"Brasília",state:"DF",country:"Brasil",bio:"Constrói turmas femininas do zero e programas de defesa pessoal para servidoras. Comunicação clara, ambiente respeitoso, progresso mensurável.",lookingForWork:!0,contactEmail:"ana@jobsbjj.com"},{id:"prf_08",userId:"usr_08",name:"Pedro Henrique Costa",belt:"preta",yearsTeaching:11,specialties:["Fundamentação","Guarda","Infantil"],city:"Salvador",state:"BA",country:"Brasil",bio:"Professor de fundamentação gi, com turmas de kids no sábado e adultos no período noturno. Gosta de academias com cultura de longo prazo, não de rotatividade.",lookingForWork:!0,contactEmail:"pedro@jobsbjj.com"}],t=[{id:"acd_01",userId:"usr_a1",name:"Instituto Horizonte",city:"São Paulo",state:"SP",country:"Brasil",bio:"Academia de médio porte na zona oeste paulistana. Três horários de adulto, kids no contraturno e uma equipe amadora. Busca professor titular com visão de currículo.",website:"https://exemplo.jobsbjj.com/horizonte",hiring:!0,address:"Rua Harmonia, 1200 — Vila Madalena",phone:"(11) 3000-0101",contactEmail:"horizonte@jobsbjj.com",hasPaidAccess:!0},{id:"acd_02",userId:"usr_a2",name:"Casa do Kimono",city:"Rio de Janeiro",state:"RJ",country:"Brasil",bio:"Espaço independente em Botafogo, com turmas kids lotadas e necessidade de reforço no vespertino. Cultura informal, tatame bem cuidado.",website:"https://exemplo.jobsbjj.com/kimono",hiring:!0,address:"Rua Voluntários da Pátria, 440 — Botafogo",phone:"(21) 3000-0202",contactEmail:"kimono@jobsbjj.com",hasPaidAccess:!1},{id:"acd_03",userId:"usr_a3",name:"Tatame Atlântico",city:"Recife",state:"PE",country:"Brasil",bio:"Centro de treino com ênfase em defesa pessoal e iniciantes adultos. Assinatura ativa no Jobs BJJ para avaliar professores com consentimento.",website:"https://exemplo.jobsbjj.com/atlantico",hiring:!0,address:"Av. Boa Viagem, 890 — Boa Viagem",phone:"(81) 3000-0303",contactEmail:"atlantico@jobsbjj.com",hasPaidAccess:!0},{id:"acd_04",userId:"usr_a4",name:"Guarda Alta",city:"Curitiba",state:"PR",country:"Brasil",bio:"Equipe competitiva em crescimento. Sem assinatura mensal — usa desbloqueio pontual quando encontra um perfil alinhado.",website:"https://exemplo.jobsbjj.com/guardaalta",hiring:!0,address:"Rua Chile, 55 — Rebouças",phone:"(41) 3000-0404",contactEmail:"guardaalta@jobsbjj.com",hasPaidAccess:!1},{id:"acd_05",userId:"u